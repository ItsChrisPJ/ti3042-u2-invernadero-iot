<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hk_surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/hk_accent_lifeblood_glow" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hk_surface_dark_well" />
            <stroke
                android:width="1dp"
                android:color="@color/hk_border_stone" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
