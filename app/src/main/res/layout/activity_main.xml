<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_void_vignette"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top HUD Bar Minimalista -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_vessel_mask"
                android:layout_marginEnd="12dp"
                android:contentDescription="HUD Máscara Vasija" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWelcomeUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOLA, AGRICULTOR"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    android:textColor="@color/hk_text_soul" />

                <TextView
                    android:id="@+id/tvUserRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROL: OPERADOR DE INVERNADERO"
                    android:textSize="10sp"
                    android:textColor="@color/hk_text_mask" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="SALIR"
                android:textColor="@color/hk_accent_grimm"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

        <!-- SECCIÓN 1: INTERCONEXIÓN ENTRE 2 DISPOSITIVOS (CRITERIO 2.1.4) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTERCONEXIÓN IOT (2 DISPOSITIVOS)"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_mask"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecciona el rol de este equipo para la prueba inalámbrica:"
                android:textSize="11sp"
                android:textColor="@color/hk_text_lore"
                android:layout_marginBottom="12dp" />

            <!-- Botón Dispositivo 1: Nodo Invernadero -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenGreenhouseNode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="DISPOSITIVO 1: NODO INVERNADERO (SERVIDOR)"
                android:letterSpacing="0.05"
                android:textColor="@color/hk_text_soul"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_soul_button"
                android:layout_marginBottom="10dp" />

            <!-- Botón Dispositivo 2: Panel Agricultor -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenGreenhouseMonitor"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="DISPOSITIVO 2: PANEL AGRICULTOR (CLIENTE)"
                android:letterSpacing="0.05"
                android:textColor="@color/hk_accent_lifeblood_glow"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_soul_button"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conecta ambos dispositivos a la misma red Wi-Fi o prueba en bucle local (127.0.0.1)."
                android:textSize="10sp"
                android:textColor="@color/hk_text_lore" />

        </LinearLayout>

        <!-- SECCIÓN 2: ESTADO INALÁMBRICO Y PERMISOS (CLASE 03) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONECTIVIDAD INALÁMBRICA &amp; PERMISOS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_mask"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <!-- Pozo de datos de red -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_charm_well"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvWifiStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wi-Fi: Consultando estado..."
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/hk_text_soul"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvLocalIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP Local: En reposo..."
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/hk_accent_lifeblood_glow" />
            </LinearLayout>

            <!-- Botón Solicitar Permisos -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSolicitarPermiso"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="GESTIONAR PERMISOS INALÁMBRICOS"
                android:letterSpacing="0.05"
                android:textColor="@color/hk_text_mask"
                android:textSize="11sp"
                android:background="@drawable/bg_secondary_button"
                android:layout_marginBottom="8dp" />

            <!-- Botones de consulta Wi-Fi y Bluetooth -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNombreWifi"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="REFRESCAR WI-FI"
                    android:textColor="@color/hk_text_mask"
                    android:textSize="10sp"
                    android:background="@drawable/bg_secondary_button"
                    android:layout_marginEnd="4dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnListarBluetooth"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="VER BLUETOOTH"
                    android:textColor="@color/hk_text_mask"
                    android:textSize="10sp"
                    android:background="@drawable/bg_secondary_button"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- SECCIÓN 3: ALMACENAMIENTO SQLITE (CRITERIO 2.1.2) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALMACENAMIENTO LOCAL SQLITE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_mask"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consulta las lecturas de telemetría y sensores preservadas localmente en la base de datos."
                android:textSize="11sp"
                android:textColor="@color/hk_text_lore"
                android:layout_marginBottom="12dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenHistory"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="VER HISTORIAL DE MEDICIONES (SQLITE)"
                android:letterSpacing="0.05"
                android:textColor="@color/hk_accent_geo_glow"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_soul_button" />

        </LinearLayout>

        <!-- SECCIÓN 4: PASO DE DATOS ENTRE ACTIVIDADES (CLASE 02) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASO DE PARÁMETROS (INTENTS CLASE 02)"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_mask"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Texto o parámetro para DetalleActivity"
                app:boxStrokeColor="@color/hk_accent_lifeblood_glow"
                app:hintTextColor="@color/hk_text_mask"
                android:textColorHint="@color/hk_text_lore"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hk_text_soul"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnviar"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="TRANSMITIR A DETALLEACTIVITY"
                android:letterSpacing="0.05"
                android:textColor="@color/hk_text_mask"
                android:textSize="11sp"
                android:background="@drawable/bg_secondary_button" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>