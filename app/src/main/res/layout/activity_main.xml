<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_void_vignette"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top HUD Bar: Inspirada en el HUD de Vasija y Máscaras -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp">

            <!-- Avatar: Vasija en hueco de piedra -->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_vessel_mask"
                android:layout_marginEnd="12dp"
                android:contentDescription="HUD Máscara Vasija" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWelcomeUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOLA, AGRICULTOR"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:textColor="@color/hk_text_soul" />

                <TextView
                    android:id="@+id/tvUserRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MUESCA: OPERADOR DE INVERNADERO"
                    android:textSize="11sp"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"
                    android:textColor="@color/hk_text_mask"
                    android:textStyle="italic" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="SALIR"
                android:fontFamily="serif"
                android:letterSpacing="0.10"
                android:textColor="@color/hk_accent_grimm"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- Divisor Ornamental Hallownest -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_hallownest_divider"
            android:contentDescription="Divisor" />

        <!-- SECCIÓN 1: INTERCONEXIÓN ENTRE 2 DISPOSITIVOS (CRITERIO 2.1.4) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◈ INTERCONEXIÓN DE ALMAS IOT (2 DISPOSITIVOS)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_soul"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecciona la muesca de rol para este artefacto en la prueba:"
                android:textSize="11sp"
                android:fontFamily="serif"
                android:textColor="@color/hk_text_lore"
                android:textStyle="italic"
                android:layout_marginBottom="12dp" />

            <!-- Botón Dispositivo 1: Nodo Invernadero -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenGreenhouseNode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🌿 DISPOSITIVO 1: NODO INVERNADERO"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_soul_button"
                android:layout_marginBottom="10dp" />

            <!-- Botón Dispositivo 2: Panel Agricultor -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenGreenhouseMonitor"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="✦ DISPOSITIVO 2: PANEL AGRICULTOR"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_accent_lifeblood_glow"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_soul_button"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aviso: Ejecuta el Disp 1 en un artefacto y el Disp 2 en otro dentro de la misma red Wi-Fi, o sintoniza en bucle local (127.0.0.1) en un solo artefacto."
                android:textSize="10sp"
                android:fontFamily="serif"
                android:textColor="@color/hk_text_lore"
                android:textStyle="italic" />

        </LinearLayout>

        <!-- SECCIÓN 2: ESTADO INALÁMBRICO Y PERMISOS (CLASE 03) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◈ SINTONIZACIÓN INALÁMBRICA Y PERMISOS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_soul"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Pozo de datos de red -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_charm_well"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvWifiStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wi-Fi: Sintonizando frecuencia..."
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:textColor="@color/hk_text_soul"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvLocalIp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP Local: En reposo..."
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/hk_accent_lifeblood_glow" />
            </LinearLayout>

            <!-- Botón Solicitar Permisos -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSolicitarPermiso"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="CONCEDER PERMISOS INALÁMBRICOS"
                android:fontFamily="serif"
                android:letterSpacing="0.10"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_mask"
                android:textSize="11sp"
                android:background="@drawable/bg_secondary_button"
                android:layout_marginBottom="8dp" />

            <!-- Botones de consulta Wi-Fi y Bluetooth -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNombreWifi"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="REFRESCAR WI-FI"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"
                    android:textColor="@color/hk_text_mask"
                    android:textSize="10sp"
                    android:background="@drawable/bg_secondary_button"
                    android:layout_marginEnd="4dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnListarBluetooth"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="VER BLUETOOTH"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"
                    android:textColor="@color/hk_text_mask"
                    android:textSize="10sp"
                    android:background="@drawable/bg_secondary_button"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- SECCIÓN 3: ALMACENAMIENTO SQLITE (CRITERIO 2.1.2) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◈ DIARIO DEL CAZADOR • ALMACENAMIENTO SQLITE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_soul"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consulta las inscripciones de telemetría preservadas en la roca local de este dispositivo mediante SQLite."
                android:textSize="11sp"
                android:fontFamily="serif"
                android:textColor="@color/hk_text_lore"
                android:textStyle="italic"
                android:layout_marginBottom="12dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnOpenHistory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="TABLILLA DE MEDICIONES HISTÓRICAS"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_accent_geo_glow"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_soul_button" />

        </LinearLayout>

        <!-- SECCIÓN 4: PASO DE DATOS ENTRE ACTIVIDADES (CLASE 02) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◈ TRANSMISIÓN DE SELLOS (INTENTS CLASE 02)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_soul"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Inscripción o ID para DetalleActivity"
                app:boxStrokeColor="@color/hk_border_pale_ore"
                app:hintTextColor="@color/hk_text_mask"
                android:textColorHint="@color/hk_border_pale_ore"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="10dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hk_text_soul"
                    android:fontFamily="serif"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnviar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="TRANSMITIR A DETALLEACTIVITY"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_mask"
                android:textSize="11sp"
                android:background="@drawable/bg_secondary_button" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>