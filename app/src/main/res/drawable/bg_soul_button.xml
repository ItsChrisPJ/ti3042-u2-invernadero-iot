<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Estado Presionado: Destello de Alma con Resplandor Cian -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/hk_surface_elevated" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/hk_accent_soul_glow" />
                </shape>
            </item>
            <item
                android:top="2dp"
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1dp"
                        android:color="@color/hk_text_soul" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Estado Normal: Fondo Crossroads Slate con Borde de Alma -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/hk_surface_card" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/hk_text_soul" />
                </shape>
            </item>
            <item
                android:top="2dp"
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1dp"
                        android:color="@color/hk_border_pale_ore" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
