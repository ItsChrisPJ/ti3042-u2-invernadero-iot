<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_void_vignette"
    tools:context=".ui.DetalleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- Icono de Máscara de Vasija -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_vessel_mask"
            android:contentDescription="Máscara"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DETALLE DE INTENT"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_soul"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRANSMISIÓN DE DATOS ENTRE ACTIVIDADES • CLASE 02"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:textColor="@color/hk_text_mask"
            android:textAlignment="center"
            android:layout_marginBottom="24dp" />

        <!-- Contenedor del Mensaje Recibido -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="24dp"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PARÁMETRO RECIBIDO:"
                android:textSize="10sp"
                android:letterSpacing="0.06"
                android:textStyle="bold"
                android:textColor="@color/hk_text_mask"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txtDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="El texto transmitido aparecerá aquí"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/hk_accent_lifeblood_glow"
                android:textAlignment="center" />
        </LinearLayout>

        <!-- Botón para regresar a MainActivity -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="REGRESAR AL MENÚ PRINCIPAL"
            android:letterSpacing="0.06"
            android:textColor="@color/hk_text_soul"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_soul_button" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>