<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_void_vignette"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Emblema Superior: Máscara de Vasija -->
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_vessel_mask"
            android:contentDescription="Máscara de Vasija" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="CREAR CUENTA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_soul" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="REGISTRO DE OPERADOR EN BASE DE DATOS SQLITE"
            android:textSize="10sp"
            android:letterSpacing="0.06"
            android:textColor="@color/hk_text_mask"
            android:layout_marginBottom="24dp" />

        <!-- Tarjeta de Registro Minimalista -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <!-- Nombre Completo -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_full_name"
                app:boxStrokeColor="@color/hk_accent_lifeblood_glow"
                app:hintTextColor="@color/hk_text_mask"
                android:textColorHint="@color/hk_text_lore"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hk_text_soul"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Usuario -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_username"
                app:boxStrokeColor="@color/hk_accent_lifeblood_glow"
                app:hintTextColor="@color/hk_text_mask"
                android:textColorHint="@color/hk_text_lore"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hk_text_soul"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Rol -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ROL DEL USUARIO:"
                android:textSize="10sp"
                android:letterSpacing="0.06"
                android:textStyle="bold"
                android:textColor="@color/hk_text_mask"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spnRole"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_charm_well"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="14dp" />

            <!-- Contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/hk_text_mask"
                app:boxStrokeColor="@color/hk_accent_lifeblood_glow"
                app:hintTextColor="@color/hk_text_mask"
                android:textColorHint="@color/hk_text_lore"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hk_text_soul"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirmar Contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_confirm_password"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/hk_text_mask"
                app:boxStrokeColor="@color/hk_accent_lifeblood_glow"
                app:hintTextColor="@color/hk_text_mask"
                android:textColorHint="@color/hk_text_lore"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="20dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hk_text_soul"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón Registrar -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="REGISTRAR USUARIO"
                android:letterSpacing="0.06"
                android:textColor="@color/hk_text_soul"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_soul_button"
                android:layout_marginBottom="10dp" />

            <!-- Botón Volver -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBackToLogin"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="VOLVER AL INICIO DE SESIÓN"
                android:textColor="@color/hk_text_mask"
                android:textSize="11sp"
                android:background="@drawable/bg_secondary_button" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
