<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hallownest_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="2dp">

    <!-- Fila Superior: Fecha y Modo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvItemTimestamp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2026-11-03 14:35:10"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="@color/hk_text_lore" />

        <TextView
            android:id="@+id/tvItemMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTO"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/hk_text_soul"
            android:background="@drawable/bg_charm_well"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Fila Inferior: Métricas de Telemetría -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Temperatura -->
        <TextView
            android:id="@+id/tvItemTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="25.4 °C"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/hk_accent_greenpath"
            android:layout_marginEnd="16dp" />

        <!-- Humedad -->
        <TextView
            android:id="@+id/tvItemHumidity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="62.0 %"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/hk_accent_lifeblood_glow" />

        <!-- Estado Ventilador -->
        <TextView
            android:id="@+id/tvItemFanStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VENTILADOR ON"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/hk_text_soul"
            android:background="@drawable/bg_charm_well"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

</LinearLayout>
