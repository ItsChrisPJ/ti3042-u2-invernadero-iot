<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_void_vignette"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Emblema Superior: Máscara de la Vasija -->
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:src="@drawable/ic_vessel_mask"
            android:contentDescription="Máscara de Vasija" />

        <!-- Título Minimalista -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.08"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_soul" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="MONITOREO &amp; CONTROL INALÁMBRICO • TI3042"
            android:textSize="11sp"
            android:letterSpacing="0.06"
            android:textColor="@color/hk_text_mask"
            android:layout_marginBottom="24dp" />

        <!-- Tarjeta de Acceso Minimalista -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INICIAR SESIÓN"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/hk_text_soul"
                android:layout_marginBottom="16dp" />

            <!-- Input Usuario -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_username"
                app:boxStrokeColor="@color/hk_accent_lifeblood_glow"
                app:hintTextColor="@color/hk_text_mask"
                android:textColorHint="@color/hk_text_lore"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="14dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hk_text_soul"
                    android:inputType="textPersonName"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/hk_text_mask"
                app:boxStrokeColor="@color/hk_accent_lifeblood_glow"
                app:hintTextColor="@color/hk_text_mask"
                android:textColorHint="@color/hk_text_lore"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="20dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hk_text_soul"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón Primario: Iniciar Sesión -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="INGRESAR A LA PLATAFORMA"
                android:letterSpacing="0.06"
                android:textColor="@color/hk_text_soul"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_soul_button"
                android:layout_marginBottom="10dp" />

            <!-- Botón Secundario: Credenciales Demo -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnQuickDemo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="CARGAR CREDENCIALES DEMO (ADMIN)"
                android:letterSpacing="0.05"
                android:textColor="@color/hk_text_mask"
                android:textSize="11sp"
                android:background="@drawable/bg_secondary_button"
                android:layout_marginBottom="14dp" />

            <!-- Enlace Registro -->
            <TextView
                android:id="@+id/tvGoRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿No tienes cuenta? Regístrate aquí"
                android:textColor="@color/hk_accent_lifeblood_glow"
                android:textSize="12sp"
                android:padding="6dp"
                android:layout_gravity="center_horizontal" />

        </LinearLayout>

        <!-- Sello de Seguridad ISO/IEC 27400 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_charm_notch"
                    app:tint="@color/hk_accent_lifeblood_glow"
                    android:contentDescription="Sello"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEGURIDAD CRIPTOGRÁFICA (ISO/IEC 27400)"
                    android:letterSpacing="0.06"
                    android:textStyle="bold"
                    android:textColor="@color/hk_accent_lifeblood_glow"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Credenciales selladas con Hashing SHA-256 y Salt aleatorio de 16 bytes. Autenticación local segura en SQLite sin almacenamiento en texto plano."
                android:textColor="@color/hk_text_lore"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
