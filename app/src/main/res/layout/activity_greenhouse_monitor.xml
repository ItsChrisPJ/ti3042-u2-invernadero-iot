<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_void_vignette"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado Estilo Hallownest -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PANEL AGRICULTOR"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.14"
                    android:textAllCaps="true"
                    android:textColor="@color/hk_text_soul" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISPOSITIVO 2 • SINTONIZACIÓN Y CONTROL REMOTO"
                    android:textSize="10sp"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:textColor="@color/hk_text_mask"
                    android:textStyle="italic" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="VOLVER"
                android:fontFamily="serif"
                android:letterSpacing="0.10"
                android:textColor="@color/hk_text_mask"
                android:textSize="11sp"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

        <!-- Divisor Ornamental Hallownest -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginBottom="14dp"
            android:src="@drawable/ic_hallownest_divider"
            android:contentDescription="Divisor" />

        <!-- TARJETA 1: CONEXIÓN INALÁMBRICA AL NODO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◈ VÍNCULO CON EL NODO INVERNADERO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:layout_marginBottom="8dp" />

            <!-- Input IP del Servidor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilIpAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="IP del Nodo (Dispositivo 1)"
                    app:boxStrokeColor="@color/hk_border_pale_ore"
                    app:hintTextColor="@color/hk_text_mask"
                    android:textColorHint="@color/hk_border_pale_ore"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etIpAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="192.168.1.100"
                        android:textColor="@color/hk_text_soul"
                        android:fontFamily="monospace"
                        android:textSize="13sp"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnUseLoopback"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:text="127.0.0.1"
                    android:fontFamily="monospace"
                    android:textColor="@color/hk_accent_lifeblood_glow"
                    android:textSize="11sp"
                    android:background="@drawable/bg_secondary_button"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Botón Conectar/Desconectar -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnToggleConnection"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="FORJAR VÍNCULO CON INVERNADERO"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_soul_button"
                android:layout_marginBottom="8dp" />

            <!-- Estado de Conexión -->
            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado: Desconectado"
                android:textSize="11sp"
                android:fontFamily="serif"
                android:textColor="@color/hk_accent_grimm"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- TARJETA 2: TELEMETRÍA EN TIEMPO REAL (DHT11) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◈ TELEMETRÍA EN TIEMPO REAL (DHT11)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:layout_marginBottom="10dp" />

            <!-- Banner de Alerta de Infección (> 28°C) -->
            <TextView
                android:id="@+id/tvAlertBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✦ ¡ALERTA DE INFECCIÓN! TEMPERATURA CRÍTICA (> 28°C)"
                android:textColor="@color/hk_text_soul"
                android:background="@drawable/bg_infection_badge"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:textStyle="bold"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <!-- Valores de Sensores en Pozos de Piedra -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Pozo Temperatura -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_charm_well"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEMPERATURA"
                        android:textSize="10sp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.10"
                        android:textStyle="bold"
                        android:textColor="@color/hk_text_mask" />

                    <TextView
                        android:id="@+id/tvMonitorTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--.- °C"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:textColor="@color/hk_accent_greenpath"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Pozo Humedad -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_charm_well"
                    android:padding="12dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HUMEDAD SAVIA"
                        android:textSize="10sp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.10"
                        android:textStyle="bold"
                        android:textColor="@color/hk_text_mask" />

                    <TextView
                        android:id="@+id/tvMonitorHumidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--.- %"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:textColor="@color/hk_accent_lifeblood_glow"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Estado del Ventilador Remoto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="VENTILADOR EN NODO REMOTO:"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"
                    android:textSize="11sp"
                    android:textColor="@color/hk_text_mask" />

                <TextView
                    android:id="@+id/tvMonitorFanStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DESCONOCIDO"
                    android:fontFamily="serif"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="@color/hk_border_pale_ore" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLastUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Última sintonización: Sin datos"
                android:textSize="10sp"
                android:fontFamily="serif"
                android:textColor="@color/hk_text_lore"
                android:textStyle="italic" />

        </LinearLayout>

        <!-- TARJETA 3: CONTROL REMOTO DE ACTUADORES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◈ CONTROL REMOTO DE ACTUADORES"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:layout_marginBottom="10dp" />

            <!-- Switch Material Remoto (Criterio 2.1.1.2) -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchMonitorFan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INTERRUPTOR REMOTO VENTILADOR (SWITCH)"
                android:fontFamily="serif"
                android:letterSpacing="0.06"
                android:textColor="@color/hk_text_soul"
                android:textSize="11sp"
                android:layout_marginBottom="8dp" />

            <!-- Botones de Acción Inalámbrica -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTurnFanOn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="💨 ENCENDER"
                    android:fontFamily="serif"
                    android:letterSpacing="0.10"
                    android:textColor="@color/hk_accent_lifeblood_glow"
                    android:textSize="11sp"
                    android:background="@drawable/bg_secondary_button"
                    android:layout_marginEnd="4dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnTurnFanOff"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="🛑 APAGAR"
                    android:fontFamily="serif"
                    android:letterSpacing="0.10"
                    android:textColor="@color/hk_accent_grimm"
                    android:textSize="11sp"
                    android:background="@drawable/bg_secondary_button"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnToggleAutoMode"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="ALTERNAR MODO AUTO / MANUAL"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:textColor="@color/hk_text_mask"
                android:textSize="11sp"
                android:background="@drawable/bg_secondary_button" />

        </LinearLayout>

        <!-- TARJETA 4: ALMACENAMIENTO SQLITE (CRITERIO 2.1.2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◈ GRABADO EN DIARIO SQLITE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:layout_marginBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSaveReadingSqlite"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="📥 GRABAR TELEMETRÍA EN SQLITE"
                android:fontFamily="serif"
                android:letterSpacing="0.10"
                android:textColor="@color/hk_text_soul"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_soul_button"
                android:layout_marginBottom="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGoHistory"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="CONSULTAR DIARIO COMPLETO"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:textColor="@color/hk_accent_geo_glow"
                android:textSize="11sp"
                android:background="@drawable/bg_secondary_button" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
