<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_void_vignette"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Encabezado Minimalista -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HISTORIAL DE MEDICIONES"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERSISTENCIA LOCAL EN SQLITE (OFFLINE)"
                android:textSize="10sp"
                android:textColor="@color/hk_text_mask" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="VOLVER"
            android:textColor="@color/hk_text_mask"
            android:textSize="10sp"
            android:background="@drawable/bg_secondary_button"
            android:paddingHorizontal="14dp" />
    </LinearLayout>

    <!-- Tarjeta de Estadísticas Resumen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_hallownest_card"
        android:padding="14dp"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <!-- Total de Registros -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvTotalReadings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/hk_accent_geo_glow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REGISTROS"
                android:textSize="9sp"
                android:letterSpacing="0.06"
                android:textStyle="bold"
                android:textColor="@color/hk_text_mask" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/hk_border_stone" />

        <!-- Promedio Temperatura -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvAvgTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--.- °C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/hk_accent_greenpath" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TEMP. MEDIA"
                android:textSize="9sp"
                android:letterSpacing="0.06"
                android:textStyle="bold"
                android:textColor="@color/hk_text_mask" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/hk_border_stone" />

        <!-- Promedio Humedad -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvAvgHum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--.- %"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/hk_accent_lifeblood_glow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HUM. MEDIA"
                android:textSize="9sp"
                android:letterSpacing="0.06"
                android:textStyle="bold"
                android:textColor="@color/hk_text_mask" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botones de Acción de BD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPreloadSample"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="+ Cargar Demo"
            android:textColor="@color/hk_text_soul"
            android:textSize="11sp"
            android:background="@drawable/bg_secondary_button"
            android:layout_marginEnd="4dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClearHistory"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:text="Limpiar Historial"
            android:textColor="@color/hk_accent_grimm"
            android:textSize="11sp"
            android:background="@drawable/bg_secondary_button"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Mensaje de Estado Vacío -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No se han registrado lecturas aún en SQLite.\nGraba telemetría desde el Panel del Agricultor o presiona '+ Cargar Demo'."
        android:textAlignment="center"
        android:lineSpacingExtra="3dp"
        android:padding="24dp"
        android:textSize="12sp"
        android:textColor="@color/hk_text_lore"
        android:visibility="gone" />

    <!-- RecyclerView de Mediciones -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReadings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>
