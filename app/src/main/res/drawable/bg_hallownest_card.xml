<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa 1: Borde Exterior de Piedra de Hallownest (#3A4154) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hk_surface_card" />
            <stroke
                android:width="1dp"
                android:color="@color/hk_border_stone" />
        </shape>
    </item>

    <!-- Capa 2: Borde Interior de Mineral Pálido (#6E7891) separado por 3dp -->
    <item
        android:top="3dp"
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hk_surface_card" />
            <stroke
                android:width="1dp"
                android:color="@color/hk_border_pale_ore" />
        </shape>
    </item>
</layer-list>
