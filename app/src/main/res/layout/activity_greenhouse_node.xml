<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_void_vignette"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado Minimalista -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NODO INVERNADERO"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true"
                    android:textColor="@color/hk_text_soul" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISPOSITIVO 1 • SERVIDOR SOCKET Y SENSORES"
                    android:textSize="10sp"
                    android:textColor="@color/hk_text_mask" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="VOLVER"
                android:textColor="@color/hk_text_mask"
                android:textSize="10sp"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

        <!-- TARJETA 1: SERVIDOR INALÁMBRICO (SOCKETS TCP) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVIDOR SOCKET TCP (PUERTO 8080)"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado: Iniciando servidor..."
                android:textSize="11sp"
                android:textColor="@color/hk_accent_greenpath"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Inset de IP del Nodo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_charm_well"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIRECCIÓN DEL NODO:"
                    android:textStyle="bold"
                    android:textColor="@color/hk_text_mask"
                    android:textSize="11sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvServerIpAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="192.168.1.100:8080"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textColor="@color/hk_accent_lifeblood_glow" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresa esta IP en el Dispositivo 2 (Panel Agricultor) para conectar."
                android:textSize="10sp"
                android:textColor="@color/hk_text_lore"
                android:layout_marginBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnToggleServer"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="REINICIAR SERVIDOR"
                android:textColor="@color/hk_text_mask"
                android:textSize="11sp"
                android:background="@drawable/bg_secondary_button" />

        </LinearLayout>

        <!-- TARJETA 2: SIMULADOR DE SENSOR DHT11 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENSOR DHT11 • TELEMETRÍA EN VIVO"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:layout_marginBottom="12dp" />

            <!-- Display Temperatura y Humedad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="12dp">

                <!-- Inset Temperatura -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_charm_well"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEMPERATURA"
                        android:textSize="10sp"
                        android:letterSpacing="0.06"
                        android:textStyle="bold"
                        android:textColor="@color/hk_text_mask" />

                    <TextView
                        android:id="@+id/tvNodeTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24.5 °C"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/hk_accent_greenpath"
                        android:layout_marginVertical="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnTempMinus"
                            android:layout_width="38dp"
                            android:layout_height="34dp"
                            android:text="-"
                            android:textColor="@color/hk_text_soul"
                            android:textSize="16sp"
                            android:background="@drawable/bg_secondary_button"
                            android:layout_marginEnd="6dp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnTempPlus"
                            android:layout_width="38dp"
                            android:layout_height="34dp"
                            android:text="+"
                            android:textColor="@color/hk_text_soul"
                            android:textSize="16sp"
                            android:background="@drawable/bg_secondary_button" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Inset Humedad -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_charm_well"
                    android:padding="12dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HUMEDAD RELATIVA"
                        android:textSize="10sp"
                        android:letterSpacing="0.06"
                        android:textStyle="bold"
                        android:textColor="@color/hk_text_mask" />

                    <TextView
                        android:id="@+id/tvNodeHumidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="62.0 %"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/hk_accent_lifeblood_glow"
                        android:layout_marginVertical="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnHumMinus"
                            android:layout_width="38dp"
                            android:layout_height="34dp"
                            android:text="-"
                            android:textColor="@color/hk_text_soul"
                            android:textSize="16sp"
                            android:background="@drawable/bg_secondary_button"
                            android:layout_marginEnd="6dp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnHumPlus"
                            android:layout_width="38dp"
                            android:layout_height="34dp"
                            android:text="+"
                            android:textColor="@color/hk_text_soul"
                            android:textSize="16sp"
                            android:background="@drawable/bg_secondary_button" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Slider de Calibración de Temperatura (Criterio 2.1.1.2) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CALIBRACIÓN POR SLIDER (15°C - 45°C):"
                android:textSize="10sp"
                android:letterSpacing="0.06"
                android:textStyle="bold"
                android:textColor="@color/hk_text_mask"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderNodeTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="15.0"
                android:valueTo="45.0"
                android:stepSize="0.5"
                android:value="24.5"
                app:thumbColor="@color/hk_text_soul"
                app:trackColorActive="@color/hk_accent_lifeblood_glow"
                app:trackColorInactive="@color/hk_border_stone"
                android:layout_marginBottom="10dp" />

            <!-- Botones de Escenarios Rápidos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSimulateHeatAlert"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Simular Calor (32°C)"
                    android:textColor="@color/hk_accent_infection"
                    android:textSize="11sp"
                    android:background="@drawable/bg_secondary_button"
                    android:layout_marginEnd="4dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSimulateOptimal"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Simular Óptimo (22°C)"
                    android:textColor="@color/hk_accent_greenpath"
                    android:textSize="11sp"
                    android:background="@drawable/bg_secondary_button"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- TARJETA 3: ACTUADOR (VENTILADOR) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTUADOR • VENTILADOR DE REFRIGERACIÓN"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:layout_marginBottom="8dp" />

            <!-- Switch Material Actuador (Criterio 2.1.1.2) -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchNodeFan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Interruptor del Ventilador (Switch On/Off)"
                android:textColor="@color/hk_text_soul"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <!-- Estado del Ventilador -->
            <TextView
                android:id="@+id/tvNodeFanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VENTILADOR: EN REPOSO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:background="@drawable/bg_charm_well"
                android:gravity="center"
                android:paddingVertical="10dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvNodeMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo: AUTOMÁTICO (Enciende ventilador si T > 28°C)"
                android:textSize="11sp"
                android:textColor="@color/hk_text_lore" />

        </LinearLayout>

        <!-- TARJETA 4: CONSOLA DE COMANDOS EN TIEMPO REAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_charm_well"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONSOLA DE TRANSMISIONES (LOG)"
                android:textColor="@color/hk_text_mask"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:textSize="10sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvNodeConsole"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:text="> Esperando conexión del Agricultor..."
                android:textColor="@color/hk_accent_lifeblood_glow"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:scrollbars="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
