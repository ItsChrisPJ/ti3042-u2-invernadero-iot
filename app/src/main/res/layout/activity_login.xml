<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_void_vignette"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Emblema Superior: Máscara de la Vasija -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_vessel_mask"
            android:contentDescription="Máscara de Vasija Hallownest" />

        <!-- Título Estilo Entrada a Zona de Hallownest -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:letterSpacing="0.18"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_soul" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="SISTEMA DE CONTROL SUBTERRÁNEO • TI3042"
            android:textSize="11sp"
            android:fontFamily="serif"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:textColor="@color/hk_text_mask"
            android:textStyle="italic" />

        <!-- Divisor Ornamental Hallownest -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp"
            android:src="@drawable/ic_hallownest_divider"
            android:contentDescription="Divisor de Hallownest" />

        <!-- Tablilla de Acceso (Tarjeta con marco de doble línea) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TABLILLA DE ACCESO"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.16"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:layout_marginBottom="16dp" />

            <!-- Input Usuario -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_username"
                app:boxStrokeColor="@color/hk_border_pale_ore"
                app:hintTextColor="@color/hk_text_mask"
                android:textColorHint="@color/hk_border_pale_ore"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="14dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hk_text_soul"
                    android:fontFamily="serif"
                    android:inputType="textPersonName"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input Contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_password"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/hk_text_mask"
                app:boxStrokeColor="@color/hk_border_pale_ore"
                app:hintTextColor="@color/hk_text_mask"
                android:textColorHint="@color/hk_border_pale_ore"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="20dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hk_text_soul"
                    android:fontFamily="serif"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón Primario: Soul Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="ENFOCAR ALMA • ENTRAR"
                android:fontFamily="serif"
                android:letterSpacing="0.15"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_soul_button"
                android:layout_marginBottom="12dp" />

            <!-- Botón Secundario: Credenciales Demo -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnQuickDemo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="USAR AMULETO DEMO (ADMIN)"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_mask"
                android:textSize="12sp"
                android:background="@drawable/bg_secondary_button"
                android:layout_marginBottom="16dp" />

            <!-- Enlace Inscripción -->
            <TextView
                android:id="@+id/tvGoRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="‹ INSCRIBIR NUEVO VIAJERO ›"
                android:textColor="@color/hk_accent_lifeblood_glow"
                android:fontFamily="serif"
                android:letterSpacing="0.14"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="8dp"
                android:layout_gravity="center_horizontal" />

        </LinearLayout>

        <!-- Sello de Seguridad Criptográfico ISO/IEC 27400 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_charm_notch"
                    app:tint="@color/hk_accent_lifeblood_glow"
                    android:contentDescription="Sello"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELLO DE VINCULACIÓN (ISO/IEC 27400)"
                    android:fontFamily="serif"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:textColor="@color/hk_accent_lifeblood_glow"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Credenciales selladas mediante Hash SHA-256 y Salt criptográfico aleatorio de 16 bytes. Ni una gota de texto plano escapa al Vacío."
                android:fontFamily="serif"
                android:textColor="@color/hk_text_lore"
                android:textStyle="italic"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
