<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_bg"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp"
    android:layout_marginBottom="10dp"
    android:layout_marginHorizontal="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvItemTimestamp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2026-11-03 14:35:10"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvItemMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@color/screen_bg"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Temperatura -->
            <TextView
                android:id="@+id/tvItemTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌡️ 25.4 °C"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/temp_optimal"
                android:layout_marginEnd="16dp" />

            <!-- Humedad -->
            <TextView
                android:id="@+id/tvItemHumidity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💧 62.0 %"
                android:textSize="15sp"
                android:textColor="@color/temp_cold" />

            <!-- Estado Ventilador -->
            <TextView
                android:id="@+id/tvItemFanStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VENTILADOR ON"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@color/fan_active"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
