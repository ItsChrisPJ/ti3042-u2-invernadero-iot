<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_void_vignette"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado Estilo Hallownest -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NODO INVERNADERO"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.14"
                    android:textAllCaps="true"
                    android:textColor="@color/hk_text_soul" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISPOSITIVO 1 • SERVIDOR SOCKET Y SENSORES"
                    android:textSize="10sp"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:textColor="@color/hk_text_mask"
                    android:textStyle="italic" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="VOLVER"
                android:fontFamily="serif"
                android:letterSpacing="0.10"
                android:textColor="@color/hk_text_mask"
                android:textSize="11sp"
                android:background="@drawable/bg_secondary_button"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

        <!-- Divisor Ornamental Hallownest -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginBottom="14dp"
            android:src="@drawable/ic_hallownest_divider"
            android:contentDescription="Divisor" />

        <!-- TARJETA 1: SERVIDOR INALÁMBRICO (SOCKETS TCP) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◈ TRANSMISOR DE ALMA LOCAL (SOCKET TCP)"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado: Iniciando servidor..."
                android:textSize="12sp"
                android:fontFamily="serif"
                android:textColor="@color/hk_accent_greenpath"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Muesca de IP del Nodo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_charm_well"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIRECCIÓN DEL NODO:"
                    android:textStyle="bold"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"
                    android:textColor="@color/hk_text_mask"
                    android:textSize="11sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvServerIpAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="192.168.1.100:8080"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:textColor="@color/hk_accent_lifeblood_glow" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresa esta IP en el Dispositivo 2 (Panel Agricultor) para forjar la conexión."
                android:textSize="10sp"
                android:fontFamily="serif"
                android:textColor="@color/hk_text_lore"
                android:textStyle="italic"
                android:layout_marginBottom="10dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnToggleServer"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="REINICIAR SERVIDOR"
                android:fontFamily="serif"
                android:letterSpacing="0.10"
                android:textColor="@color/hk_text_mask"
                android:textSize="11sp"
                android:background="@drawable/bg_secondary_button" />

        </LinearLayout>

        <!-- TARJETA 2: SIMULADOR DE SENSOR DHT11 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◈ SENSOR DHT11 • TELEMETRÍA SUBTERRÁNEA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:layout_marginBottom="12dp" />

            <!-- Display Temperatura y Humedad en Pozos de Piedra -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginBottom="12dp">

                <!-- Pozo Temperatura -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_charm_well"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TEMPERATURA"
                        android:textSize="10sp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.10"
                        android:textStyle="bold"
                        android:textColor="@color/hk_text_mask" />

                    <TextView
                        android:id="@+id/tvNodeTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24.5 °C"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:textColor="@color/hk_accent_greenpath"
                        android:layout_marginVertical="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnTempMinus"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:text="-"
                            android:textColor="@color/hk_text_soul"
                            android:textSize="16sp"
                            android:background="@drawable/bg_secondary_button"
                            android:layout_marginEnd="6dp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnTempPlus"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:textColor="@color/hk_text_soul"
                            android:textSize="16sp"
                            android:background="@drawable/bg_secondary_button" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Pozo Humedad -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_charm_well"
                    android:padding="12dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HUMEDAD SAVIA"
                        android:textSize="10sp"
                        android:fontFamily="serif"
                        android:letterSpacing="0.10"
                        android:textStyle="bold"
                        android:textColor="@color/hk_text_mask" />

                    <TextView
                        android:id="@+id/tvNodeHumidity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="62.0 %"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:fontFamily="serif"
                        android:textColor="@color/hk_accent_lifeblood_glow"
                        android:layout_marginVertical="4dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnHumMinus"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:text="-"
                            android:textColor="@color/hk_text_soul"
                            android:textSize="16sp"
                            android:background="@drawable/bg_secondary_button"
                            android:layout_marginEnd="6dp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnHumPlus"
                            android:layout_width="40dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:textColor="@color/hk_text_soul"
                            android:textSize="16sp"
                            android:background="@drawable/bg_secondary_button" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Botones de Escenarios Rápidos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSimulateHeatAlert"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="✦ INFECCIÓN (32°C)"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"
                    android:textColor="@color/hk_accent_infection"
                    android:textSize="10sp"
                    android:background="@drawable/bg_secondary_button"
                    android:layout_marginEnd="4dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSimulateOptimal"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="🌿 SENDERO VERDE (22°C)"
                    android:fontFamily="serif"
                    android:letterSpacing="0.08"
                    android:textColor="@color/hk_accent_greenpath"
                    android:textSize="10sp"
                    android:background="@drawable/bg_secondary_button"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- TARJETA 3: ACTUADOR (VENTILADOR) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hallownest_card"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◈ ACTUADOR • CORRIENTE DE AIRE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:layout_marginBottom="8dp" />

            <!-- Estado del Ventilador -->
            <TextView
                android:id="@+id/tvNodeFanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VENTILADOR: EN REPOSO"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.12"
                android:textAllCaps="true"
                android:textColor="@color/hk_text_soul"
                android:background="@drawable/bg_charm_well"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvNodeMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo: AUTOMÁTICO (Enfriamiento activo si T > 28°C)"
                android:textSize="11sp"
                android:fontFamily="serif"
                android:textColor="@color/hk_text_lore"
                android:textStyle="italic" />

        </LinearLayout>

        <!-- TARJETA 4: CONSOLA DE COMANDOS EN TIEMPO REAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_charm_well"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TABLILLA DE TRANSMISIONES EN VIVO (LOG)"
                android:textColor="@color/hk_text_mask"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.10"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvNodeConsole"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:text="> Esperando conexión del Agricultor..."
                android:textColor="@color/hk_accent_lifeblood_glow"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:scrollbars="vertical" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
